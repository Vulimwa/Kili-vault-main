# Frontend environment (Vite only loads VITE_* vars from here)
# Backend secrets belong in kili-vault-backend/.env — NOT this file.

# API base URL (leave empty in dev — Vite proxies /api to localhost:3000)
VITE_API_BASE_URL=

# Demo login (set false when Supabase Auth is wired)
VITE_DEMO_MODE=true

# Feature flags
VITE_ENABLE_COMMUNITY=true
