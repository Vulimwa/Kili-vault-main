{
  "name": "react-example",
  "private": true,
  "version": "0.0.0",
  "scripts": {
    "dev": "tsx server.ts",
    "build": "esbuild server.ts --bundle --platform=node --format=cjs --packages=external --sourcemap --outfile=dist/server.cjs",
    "start": "node dist/server.cjs",
    "test": "node --test tests/**/*.test.js",
    "clean": "rm -rf dist server.js",
    "lint": "tsc --noEmit",
    "train": "python3 -u scripts/train_models.py",
    "verify": "python3 -u scripts/verify_models.py",
    "pipeline:auto": "python3 -u scripts/run_automated_pipeline.py",
    "pipeline:live": "python -u scripts/run_pipeline.py",
    "db:setup": "node scripts/setup_database.js",
    "db:migrate-cases": "node scripts/setup_database.js --force-migrate",
    "stack:check": "node scripts/check_stack.js",
    "gee:verify": "python scripts/verify_gee.py",
    "gee:run": "python -m gee.main --output output/detections.geojson --summary output/processing_summary.json",
    "gee:ingest": "node scripts/ingest_detections.js",
    "cases:promote": "node scripts/promote_detections.js",
    "pipeline:full": "npm run gee:run && npm run gee:ingest && npm run cases:promote -- --min-confidence=0.75 --limit=25"
  },
  "dependencies": {
    "@google/genai": "^2.4.0",
    "@tailwindcss/vite": "^4.1.14",
    "@vitejs/plugin-react": "^5.0.4",
    "cors": "^2.8.6",
    "dotenv": "^17.2.3",
    "express": "^4.21.2",
    "express-rate-limit": "^8.7.0",
    "helmet": "^8.3.0",
    "multer": "^2.0.2",
    "lucide-react": "^0.546.0",
    "motion": "^12.23.24",
    "multer": "^2.4.0",
    "pg": "^8.23.0",
    "react": "^19.0.1",
    "react-dom": "^19.0.1",
    "uuid": "^14.0.2",
    "vite": "^6.2.3",
    "zod": "^4.6.0"
  },
  "devDependencies": {
    "@types/express": "^4.17.21",
    "@types/node": "^22.14.0",
    "autoprefixer": "^10.4.21",
    "esbuild": "^0.25.0",
    "supertest": "^7.2.2",
    "tailwindcss": "^4.1.14",
    "tsx": "^4.21.0",
    "typescript": "~5.8.2",
    "vite": "^6.2.3"
  }
}
