# ============================================================================
# Kili-Vault Backend Environment Configuration
# Target AOI: Kilimani Ward, Nairobi, Kenya
# Copy this file to .env and configure appropriate values for your environment.
# NEVER commit real credentials or .env files to source control.
# ============================================================================

# --- APPLICATION RUNTIME ---
NODE_ENV=development
PORT=3000
HOST=0.0.0.0
API_VERSION=v1
CORS_ORIGIN=*
LOG_LEVEL=info

# Rate Limiting (in milliseconds and max requests per window)
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX=500

# Authentication & Access Control
# In development/hackathon mode, set to true to bypass strict token validation
# In production, set to false and configure SUPABASE_URL or JWT verification
HACKATHON_DEV_AUTH_BYPASS=true
JWT_SECRET=your_jwt_secret_placeholder_min_32_chars_long

# --- DATABASE / POSTGIS ---
# Standard PostgreSQL connection string with PostGIS enabled
# Example: postgresql://postgres:password@localhost:5432/kilivault
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/kilivault
SUPABASE_DB_URL=

# Optional Supabase Connection (if using Supabase-hosted PostgreSQL)
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_SERVICE_ROLE_KEY=your_supabase_service_role_key_placeholder

# Database Connection Pool Settings
DB_POOL_MIN=2
DB_POOL_MAX=10
DB_TIMEOUT_MS=10000

# --- EARTH ENGINE & REMOTE SENSING CONFIGURATION ---
# Google Cloud project linked to Earth Engine
GEE_PROJECT_ID=your_gcp_project_id_placeholder

# Earth Engine Authentication:
# For local dev / service account authentication:
GEE_SERVICE_ACCOUNT_EMAIL=your_service_account@your_project.iam.gserviceaccount.com
GEE_SERVICE_ACCOUNT_KEY_PATH=

# Area of Interest (AOI):
# Supply either an Earth Engine asset path OR a local GeoJSON file path
# Do NOT hardcode coordinates. Application will load from one of these:
GEE_AOI_ASSET=
AOI_GEOJSON_PATH=config/kilimani_ward.geojson
AOI_NAME=Kilimani Ward, Nairobi

# Sentinel-2 Temporal Windows (YYYY-MM-DD)
BASELINE_START_DATE=2025-01-01
BASELINE_END_DATE=2025-06-30
RECENT_START_DATE=2026-01-01
RECENT_END_DATE=2026-06-30

# Remote Sensing Quality & Detection Thresholds
S2_CLOUD_THRESHOLD=20.0
MIN_VALID_OBSERVATIONS=3
SPATIAL_RESOLUTION_METERS=10.0

# Candidate Spatial Filtering (in square meters)
MIN_CANDIDATE_AREA_M2=100.0
MAX_CANDIDATE_AREA_M2=50000.0

# Spectral & Confidence Thresholds
DELTA_NDBI_THRESHOLD=0.10
DELTA_NDVI_THRESHOLD=-0.10
MIN_CONFIDENCE=0.50

# Processing Versioning
PROCESSING_VERSION=v1.0.0
ALGORITHM_VERSION=s2_diff_spectral_v1

# Optional Infrastructure Geospatial Layers (GeoJSON or PostGIS layer names)
INFRASTRUCTURE_ROADS_LAYER_PATH=
INFRASTRUCTURE_RIPARIAN_LAYER_PATH=
INFRASTRUCTURE_DRAINAGE_LAYER_PATH=

# --- MODEL CONFIGURATION ---
MODEL_VERSION=kili-vault-dev-v0.1
PRITHVI_WEIGHTS_PATH=models/prithvi/Prithvi_EO_V2_300M_TL.pt
PRITHVI_CHECKPOINT_PATH=models/checkpoints/prithvi_change_head.json
PRITHVI_CONFIG_PATH=models/prithvi/config.yaml
PRITHVI_MODEL_ID=ibm-nasa-geospatial/Prithvi-EO-2.0-300M-TL
HIGH_CONFIDENCE_THRESHOLD=0.80
MEDIUM_CONFIDENCE_THRESHOLD=0.60
MINIMUM_DETECTION_THRESHOLD=0.40
ENSEMBLE_WEIGHT_BASELINE=0.50
ENSEMBLE_WEIGHT_PRITHVI=0.30
ENSEMBLE_WEIGHT_PERSISTENCE=0.20
